init-static {
    PushInt 20000
    SetStatic 0
}

function:0 _Global_PrintMemoryUsage {
    PushString " bytes"
    GetMemoryUsage
    IntToString
    StringConcat
    PushString "Memory used: "
    StringConcat
    PrintLine
    Return
}

function:1 _Global_Main_StringArray {
    PushInt 0
    SetLocal 1

    while {
        LoadStatic 0
        LoadLocal 1
        IntLessThan
    } then {
        PushInt 1
        PushInt 1000
        CallConstructor _IntArray_int_int
        SetLocal 2
        
        PushInt 1
        CallConstructor _Int_int
        PushInt 1000
        CallConstructor _ObjectArray_int_Object
        SetLocal 3

        if {
            PushInt 0
            PushInt 1666
            LoadLocal 1
            IntModulo
            IntEqual
        } then {
            LoadLocal 1
            IntToString
            PushString "Iteration: "
            StringConcat
            PrintLine
            Call _Global_PrintMemoryUsage
        }

        PushInt 1
        LoadLocal 1
        IntAdd
        SetLocal 1
    }
    
    PushString "At the end"
    PrintLine
    Call _Global_PrintMemoryUsage
    
    PushInt 0
    Return
}
