init-static {
}

pure(int) function:1 _Global_Factorial_int {
  if {
    PushInt 1
    LoadLocal 0
    IntLessEqual
  } then {
    PushInt 1
    Return
  }
  LoadLocal 0
  PushInt 1
  LoadLocal 0
  IntSubtract
  Call _Global_Factorial_int
  IntMultiply
  Return
}

function:1 _Global_Main_StringArray {
  PushInt 50
  SetLocal 1
  if {
    PushInt 0
    LoadLocal 0
    Call _StringArray_Length_<C>
    IntNotEqual
  } then {
    PushInt 0
    LoadLocal 0
    Call _StringArray_GetAt_<C>_int
    StringToInt
    SetLocal 1
  }
  LoadLocal 1
  Call _Global_Factorial_int
  IntToString
  PrintLine
  PushInt 0
  Return
}

