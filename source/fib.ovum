pure fun Fibonacci(n: int) : int {
    if (n <= 1) {
        return n
    }

    return Fibonacci(n - 2) + Fibonacci(n - 1)
}

fun Main(args: StringArray): int {
    var n : int = 50
    
    if (args.Length() != 0) {
        n = sys::ToInt(args[0])
    }

    sys::PrintLine(sys::ToString(Fibonacci(n)))

    return 0
}